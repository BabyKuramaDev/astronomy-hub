#!/usr/bin/env bash
# Run a hub tool: bin/hub <context> <tool> [options]. bin/hub --help lists every tool.
# Example: bin/hub detection search-period --tic 100100827
# Uses the repo's .venv when bin/setup-sandbox created one, python3 otherwise.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${repo}/.venv/bin/python"
[[ -x "$python" ]] || python="python3"
cd "$repo"
if [[ $# -lt 2 || "$1" == "--help" || "$1" == "-h" ]]; then
  exec "$python" -m scripts.list_tools
fi
exec "$python" -m "contexts.$1.cli" "${@:2}"
